{
  "name": "recall-chat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node --env-file=.env.local --import tsx evals/run.ts",
    "test:live": "node --env-file=.env.local evals/live.mjs",
    "format": "prettier --write src tests evals *.json next.config.ts",
    "format:check": "prettier --check src tests evals *.json next.config.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@langchain/core": "^1.0.0",
    "@langchain/deepseek": "^1.1.24",
    "@langchain/google-genai": "^2.3.6",
    "@langchain/groq": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@supabase/supabase-js": "^2.80.0",
    "chrono-node": "^2.8.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/luxon": "^3.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
